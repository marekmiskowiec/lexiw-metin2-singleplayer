# MT2009_CLASSIC_EDITION_V1: the values a MT2009 Classic package writes over
# .env.example (tools/edition/make-edition.py). Ports, names and images differ
# from MT2009 PLUS, so both editions run on one machine side by side. The
# channels start at 13100: 14000-14032 are the cores' own P2P ports.
M2_EDITION=classic
M2_IMAGE_NAMESPACE=mt2009classic
M2_DB_PUBLISH_PORT=3307
M2_AUTH_PORT=12000
M2_GAME_PORT_RANGE=13100-13102
M2_GAME_CONTAINER_PORT_RANGE=13100-13102
M2_GAME_PORT_BASE=13100
M2_PANEL_PUBLIC_PORT=7792
M2_BRIDGE_PORT=7793
M2_SEBAN_PANEL_PORT=7794
M2_ITEMSHOP_PUBLIC_PORT=7795
M2_PANEL_STATUS_PORTS=11000,13100
M2_DIFFICULTY=hard
M2_RATE_EXP=100
M2_RATE_DROP=100
M2_RATE_YANG=100
M2_ALCHEMY=0
M2_SASHES=0
M2_AREZZO=0
M2_SEONHAE=0
M2_SIDEKICK=0
M2_AUTOHUNT=1
M2_AUTOHUNT_ITEM=1
